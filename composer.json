{
    "name": "alan2k2/cna-framework",
    "description": "CnA Framework - The Contract-Driven, High-Performance PHP 8.4+ Framework",
    "keywords": [
        "php",
        "framework",
        "laravel",
        "owasp-asvs",
        "orm",
        "ai",
        "query-builder",
        "frontend-engine",
        "vite",
        "ui-components",
        "high-performance",
        "modular",
        "api"
    ],
    "homepage": "https://alan2k2.github.io/CnA-Framework/",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alan Shaju",
            "email": "alanshaju26@icloud.com",
            "role": "Lead Architect & Senior Software Engineer"
        }
    ],
    "support": {
        "issues": "https://github.com/Alan2k2/CnA-Framework/issues",
        "source": "https://github.com/Alan2k2/CnA-Framework",
        "docs": "https://alan2k2.github.io/CnA-Framework/"
    },
    "bin": [
        "cna"
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required for default SQLite database driver",
        "ext-pdo_mysql": "Required for MySQL / MariaDB database driver",
        "ext-pdo_pgsql": "Required for PostgreSQL database driver",
        "ext-curl": "Required for HTTP client and external AI provider communication"
    },
    "autoload": {
        "psr-4": {
            "CnA\\Contracts\\": "packages/contracts/src/",
            "CnA\\Core\\": "packages/core/src/",
            "CnA\\Container\\": "packages/container/src/",
            "CnA\\Config\\": "packages/config/src/",
            "CnA\\Console\\": "packages/console/src/",
            "CnA\\Http\\": "packages/http/src/",
            "CnA\\Routing\\": "packages/routing/src/",
            "CnA\\Middleware\\": "packages/middleware/src/",
            "CnA\\Validation\\": "packages/validation/src/",
            "CnA\\Database\\": "packages/database/src/",
            "CnA\\QueryBuilder\\": "packages/query-builder/src/",
            "CnA\\Orm\\": "packages/orm/src/",
            "CnA\\Migrations\\": "packages/migrations/src/",
            "CnA\\Auth\\": "packages/auth/src/",
            "CnA\\Authorization\\": "packages/authorization/src/",
            "CnA\\Security\\": "packages/security/src/",
            "CnA\\Cache\\": "packages/cache/src/",
            "CnA\\Queue\\": "packages/queue/src/",
            "CnA\\Events\\": "packages/events/src/",
            "CnA\\Scheduler\\": "packages/scheduler/src/",
            "CnA\\Mail\\": "packages/mail/src/",
            "CnA\\Notifications\\": "packages/notifications/src/",
            "CnA\\Storage\\": "packages/storage/src/",
            "CnA\\Ai\\": "packages/ai/src/",
            "CnA\\Logging\\": "packages/logging/src/",
            "CnA\\Monitoring\\": "packages/monitoring/src/",
            "CnA\\Testing\\": "packages/testing/src/",
            "CnA\\View\\": "packages/view/src/",
            "CnA\\Frontend\\": "packages/frontend/src/",
            "CnA\\FrontendReact\\": "packages/frontend-react/src/",
            "CnA\\FrontendVue\\": "packages/frontend-vue/src/",
            "App\\": "skeleton/app/"
        },
        "files": [
            "packages/core/src/helpers.php",
            "packages/view/src/Helpers/view_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "SkeletonTests\\": "skeleton/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "policy": {
            "abandoned": {
                "audit": "fail"
            }
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
